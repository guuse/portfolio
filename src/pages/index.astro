---
import Base from "~/layouts/Base.astro";
import About from "~/components/home/About.astro";
import Contact from "~/components/home/Contact.astro";
import Experience from "~/components/home/Experience.astro";
import Hero from "~/components/home/Hero.astro";
import Learned from "~/components/home/Learned.astro";
import ProjectCovers from "~/components/home/ProjectCovers.astro";
import Skills from "~/components/home/Skills.astro";
---

<Base
  title="Guus Ekkelenkamp, tech lead infrastructure"
  description="Tech lead infrastructure at Harborn in Rotterdam: Kubernetes, GitOps and infrastructure as code on AWS and Azure."
>
  <Hero>
    <div class="wrap">
      <About />
    </div>
  </Hero>
  <ProjectCovers />
  <div class="wrap">
    <Experience />
    <Learned />
    <Skills />
    <Contact />
  </div>
</Base>

<style>
  @layer layout {
    /*
     * Everything after the hero renders only when it comes near the window, so the first
     * style and layout pass (and the relayout when a web font swaps in) covers the first
     * screen, not all eight screens of the page. Each section keeps a placeholder height
     * close to its real one (its content box, measured at 412px and 1440px) until it has rendered once; after
     * that `auto` remembers the real one. Anchors, the nav's scroll-spy and the reveals all
     * read boxes, which these still have. The paint containment that comes with it would
     * clip focus rings at a section's edge, hence the clip margin. The parts carry `data-lazy`
     * (src/scripts/anchors.ts selects on it too).
     */
    :global([data-lazy]) {
      content-visibility: auto;
      overflow-clip-margin: 8px;
    }

    /*
     * Rendered for good: everything above a place the page jumps to (a #fragment, coming
     * back), and what scrolling is about to reach, a screen ahead (src/scripts/anchors.ts).
     * A jump aimed at placeholders would land off by their error.
     */
    :global([data-lazy].cv-on) {
      content-visibility: visible;
    }

    :global(#about) {
      contain-intrinsic-block-size: auto 850px;
    }

    :global(#projects) {
      contain-intrinsic-block-size: auto 1500px;
    }

    :global(#experience) {
      contain-intrinsic-block-size: auto 2270px;
    }

    /*
     * Inside Experience, each phase's list renders on its own too: the whole section at once
     * was a long task mid-scroll. (Not the phases themselves: their dots sit outside them.)
     */
    :global(.phase > ul[data-lazy]) {
      contain-intrinsic-block-size: auto 300px;
    }

    :global(#learned) {
      contain-intrinsic-block-size: auto 380px;
    }

    :global(#skills) {
      contain-intrinsic-block-size: auto 1010px;
    }

    :global(#contact) {
      contain-intrinsic-block-size: auto 230px;
    }

    @media (--md) {
      :global(#about) {
        contain-intrinsic-block-size: auto 700px;
      }

      :global(#projects) {
        contain-intrinsic-block-size: auto 540px;
      }

      :global(#experience) {
        contain-intrinsic-block-size: auto 1700px;
      }

      :global(#learned) {
        contain-intrinsic-block-size: auto 240px;
      }

      :global(#skills) {
        contain-intrinsic-block-size: auto 560px;
      }

      :global(#contact) {
        contain-intrinsic-block-size: auto 190px;
      }
    }

    /* paper gets the whole page, every section laid out */
    @media print {
      :global([data-lazy]) {
        content-visibility: visible;
      }
    }
  }
</style>

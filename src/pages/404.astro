---
import Arrow from "~/components/ui/Arrow.astro";
import Base from "~/layouts/Base.astro";
import Drawing from "~/components/art/Drawing.astro";
import TextLink from "~/components/ui/TextLink.astro";
import { evicted } from "~/lib/art/scenes/evicted";
---

<Base title="Not found · Guus Ekkelenkamp" description="This page doesn’t exist." mainClass="wrap" noindex>
  <section class="lost" aria-labelledby="lost-title">
    <figure class="lost__art">
      <Drawing svg={evicted()} />
    </figure>
    <div class="lost__text">
      <p class="lost__code">404</p>
      <h1 id="lost-title">This pod was evicted.</h1>
      <p>
        Nothing is scheduled at this address. The page may have moved when the site was rebuilt, or it never
        existed.
      </p>
      <p class="lost__links">
        <TextLink variant="outline" href="/">
          Back to the homepage <Arrow />
        </TextLink>
        <TextLink variant="underline" href="/projects/">
          See the projects
        </TextLink>
      </p>
    </div>
  </section>
</Base>

<style>
  @layer components {
    .lost {
      display: grid;
      gap: 2rem var(--space-gutter);
      align-items: center;
      padding-block: clamp(3rem, 2rem + 5vw, 6rem);
    }

    @media (--stage) {
      .lost {
        grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      }

      .lost__art {
        order: 2;
      }
    }

    /* like a case-study hero, the drawing stays small enough for the heading to be on screen */
    .lost__art {
      display: flex;
      justify-content: center;
      height: min(clamp(200px, 58vw, 320px), 45svh);
      margin: 0;
    }

    .lost__art :global(.scene-svg) {
      width: auto;
      max-width: 100%;
      height: 100%;
    }

    .lost__code {
      color: var(--accent);
      font-family: var(--font-code);
    }

    /*
     * Two balanced lines in the web font and in the (much wider) fallback alike, so nothing
     * below it moves when the font arrives.
     */
    .lost h1 {
      max-width: 8em;
      min-height: 2lh;
      text-wrap: balance;
      margin-block: 0.5rem 1rem;
      font-family: var(--font-heading);
      font-size: var(--text-h1);
      line-height: 1;
      letter-spacing: -0.02em;
    }

    .lost__text > p:not(.lost__code, .lost__links) {
      max-width: 32em;
      color: var(--ink-muted);
      font-size: var(--text-lead);
    }

    .lost__links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-m) 22px;
      margin-top: 2rem;
    }

    /* the evicted pod drifts up and away and comes back to try again, twice, then gives up (under 5 s) */
    .lost__art :global(.evicted) {
      transform-box: fill-box;
      animation: evict 2.4s var(--ease-in-out) 2 both;
    }

    @keyframes evict {
      0%,
      100% {
        translate: 0 0;
        rotate: -4deg;
      }

      50% {
        translate: 0 -12px;
        rotate: 5deg;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .lost__art :global(.evicted) {
        animation: none;
      }
    }

    /*
     * A phone held sideways: the text on the left, the drawing beside it (like a case-study
     * hero), so the heading and the way out are on the first screen.
     */
    @media (--landscape-short) {
      .lost {
        grid-template-columns: minmax(0, 7fr) minmax(0, 3fr);
        gap: var(--space-s) var(--space-gutter);
        padding-block: var(--space-xs) var(--space-s);
      }

      .lost__art {
        order: 2;
        height: min(calc(100svh - 8rem), 240px);
      }

      .lost h1 {
        min-height: 0;
        max-width: none;
        margin-block: 0.15rem 0.4rem;
        font-size: min(var(--text-h1), 8svh + 0.75rem);
      }

      .lost__text > p:not(.lost__code, .lost__links) {
        font-size: var(--text-small);
      }

      .lost__links {
        margin-top: var(--space-s);
      }
    }
  }
</style>

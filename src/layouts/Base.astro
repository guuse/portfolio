---
import { Font } from "astro:assets";
import "~/styles/global.css";
import FontPreload from "~/components/layout/FontPreload.astro";
import SkipLink from "~/components/layout/SkipLink.astro";
import SiteHeader from "~/components/layout/SiteHeader.astro";
import SiteFooter from "~/components/layout/SiteFooter.astro";
import KeyboardSheet from "~/components/layout/KeyboardSheet.astro";
import Seo from "~/components/layout/Seo.astro";
import { site } from "~/lib/site";
import { tokens } from "~/styles/tokens";

export interface Props {
  /** The full document title. */
  title: string;
  description: string;
  /** The page's social card in public/og/ (defaults to the homepage's). */
  og?: string | undefined;
  /** Classes for <main> (case studies and the projects page wrap their content). */
  mainClass?: string | undefined;
  /** Keep a page out of search results (the 404): no canonical URL either. */
  noindex?: boolean | undefined;
  /** Open Graph type: case studies are articles. */
  type?: "website" | "article" | undefined;
}

const { title, description, og = "home", mainClass, noindex, type } = Astro.props;
/* For people reading the source. Set as HTML so the comment survives minification. */
const hello = `<!--
  Hi. View-source is a fine way to read a website; the repo is nicer:
  ${site.repo}
  Built with Astro, served by nginx from a k3s cluster, kept honest by Lighthouse in CI.
-->`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <Fragment set:html={hello} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <Seo title={title} description={description} og={og} type={type} canonical={!noindex} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={tokens.surface.hex} />
    <meta name="color-scheme" content="dark" />
    <FontPreload cssVariable="--font-serif" />
    <FontPreload cssVariable="--font-sans" />
    <Font cssVariable="--font-serif" />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <div class="site">
      <SiteHeader />
      <main id="main" class={mainClass}>
        <slot />
      </main>
      <SiteFooter />
    </div>
    <slot name="after-site" />
    <KeyboardSheet />
    <script>
      import "~/scripts/site";
    </script>
  </body>
</html>

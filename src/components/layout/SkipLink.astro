---
/** The first focusable element on every page: jumps over the header to the content. */
---

<a class="skip-link" href="#main">
  Skip to content
</a>

<style>
  @layer components {
    .skip-link {
      position: absolute;
      left: 16px;
      top: -100px;
      z-index: 100;
      padding: var(--space-s) var(--space-l);
      background: var(--ink);
      color: var(--surface);
    }

    .skip-link:focus {
      top: 16px;
    }
  }
</style>

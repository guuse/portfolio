---
/** The `?` sheet: keyboard shortcuts (src/scripts/eggs.ts). */
const keys = [
  ["g h", "Home"],
  ["g p", "Projects"],
  ["g e", "Experience"],
  ["g c", "Contact"],
  ["g d", "Design system"],
  ["?", "This sheet"],
] as const;
---

<dialog class="keys" aria-labelledby="keys-title">
  <h2 id="keys-title">Shortcuts</h2>
  <dl>
    {keys.map(([combo, what]) => (
      <div>
        <dt>
          {combo.split(" ").map((k) => (
            <kbd>{k}</kbd>
          ))}
        </dt>
        <dd>{what}</dd>
      </div>
    ))}
  </dl>
  <p class="keys__more">There is one more, from 1986. It still works.</p>
  <button type="button" class="keys__close" data-keys-close>
    Close
  </button>
</dialog>

<style>
  @layer components {
    .keys {
      width: min(100% - 32px, 380px);
      padding: 1.5rem;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-m);
      background: var(--surface-raised);
      color: var(--ink);
    }

    .keys::backdrop {
      background: var(--scrim-lightbox);
    }

    .keys h2 {
      font-family: var(--font-heading);
      font-size: var(--text-h3);
      margin-bottom: 1rem;
    }

    .keys dl {
      display: grid;
      gap: 0.5rem;
    }

    .keys dl div {
      display: grid;
      grid-template-columns: 6rem 1fr;
      align-items: center;
    }

    .keys dd {
      color: var(--ink-muted);
    }

    kbd {
      display: inline-block;
      min-width: 1.6em;
      margin-right: 4px;
      padding: 1px 6px;
      border: 1px solid var(--line-strong);
      border-bottom-width: 2px;
      border-radius: var(--radius-xs);
      font-family: var(--font-code);
      font-size: 0.85em;
      text-align: center;
    }

    .keys__more {
      margin-top: 1rem;
      color: var(--ink-subtle);
      font-size: var(--text-small);
    }

    .keys__close {
      margin-top: 1.25rem;
      min-height: 40px;
      padding: 0 1rem;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-pill);
      background: var(--ink);
      color: var(--surface);
      cursor: pointer;
    }
  }
</style>

<style is:global>
  @layer components {
    /* the Konami toast and the untap (src/scripts/eggs.ts) */
    .toast {
      position: fixed;
      left: 50%;
      bottom: max(24px, env(safe-area-inset-bottom, 0px));
      z-index: 90;
      translate: -50% 0;
      padding: 10px 16px;
      border: 1px solid var(--accent);
      border-radius: var(--radius-pill);
      background: var(--surface-raised);
      color: var(--ink);
      font-size: var(--text-small);
      animation: toast 3.2s var(--ease-out) both;
    }

    /* without motion it simply shows, for as long as it's there (eggs.ts removes it) */
    @media (prefers-reduced-motion: reduce) {
      .toast {
        animation: none;
      }
    }

    @keyframes toast {
      0%,
      100% {
        opacity: 0;
        translate: -50% 8px;
      }

      10%,
      85% {
        opacity: 1;
        translate: -50% 0;
      }
    }

    /* the prints have their own rule in Hero.astro, which outranks their .is-settled */
    .is-untapping :is(.cover__link, .pcard__media) {
      animation: untap 1.5s var(--ease-in-out);
    }

    @keyframes untap {
      40%,
      60% {
        rotate: 90deg;
      }
    }
  }
</style>

---
import { nav, site } from "~/lib/site";

const path = Astro.url.pathname;
const home = path === "/";
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__name" href="/">
      {site.name}
    </a>
    <nav class="nav" aria-label="Main">
      <ul role="list">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.match(path) ? "page" : undefined}
              data-spy={home && "section" in item ? item.section : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      {/* one underline that slides to the current entry (src/scripts/nav.ts) */}
      <span class="nav__mark" aria-hidden="true"></span>
    </nav>
  </div>
</header>

<style>
  @layer components {
    .site-header {
      position: sticky;
      top: env(safe-area-inset-top, 0);
      z-index: 20;

      /* full-bleed, so the bar spans the window and not just the content column */
      margin-inline: calc(-1 * var(--space-edge)) calc(-1 * var(--space-edge-end));
      padding-inline: var(--space-edge) var(--space-edge-end);
      background: color-mix(in oklch, var(--surface) 92%, transparent);
      backdrop-filter: blur(8px);
    }

    .site-header__inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2xs) var(--space-xl);
      min-height: var(--space-header);
    }

    .site-header__name {
      font-weight: 600;
      text-decoration: none;
    }

    .nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0 22px;
    }

    .nav a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      text-decoration: none;
      color: var(--ink-muted);
    }

    .nav a[aria-current] {
      color: var(--ink);
      text-decoration: underline;
      text-decoration-color: var(--accent);
      text-underline-offset: 0.4em;
    }

    @media (hover: hover) {
      .nav a:hover {
        color: var(--ink);
        text-decoration: underline;
        text-decoration-color: var(--accent);
        text-underline-offset: 0.4em;
      }
    }

    /*
     * With JS the current entry's underline is one element that slides between entries
     * (transform only). Without JS, the text underline above stays.
     */
    .nav {
      position: relative;
    }

    .nav__mark {
      position: absolute;
      top: 0;
      left: 0;
      width: 100px;
      height: 1px;
      background: var(--accent);
      transform-origin: 0 0;
      opacity: 0;
      pointer-events: none;
    }

    .nav:global(.has-mark) .nav__mark {
      opacity: 1;
    }

    .nav:global(.is-tracking) .nav__mark {
      transition:
        transform var(--duration-base) var(--ease-out),
        opacity var(--duration-quick);
    }

    .nav:global(.has-mark) a:global(.is-marked) {
      color: var(--ink);
      text-decoration: none;
    }

    .nav:global(.has-mark) a[aria-current]:not(:global(.is-marked), :hover) {
      color: var(--ink-muted);
      text-decoration: none;
    }

    /*
     * Forced colours paint the sliding underline away (it is a background), so the current
     * entries get a real text underline back.
     */
    @media (forced-colors: active) {
      .nav__mark {
        display: none;
      }

      .nav a[aria-current],
      .nav:global(.has-mark) a:global(.is-marked),
      .nav:global(.has-mark) a[aria-current]:not(:global(.is-marked), :hover) {
        text-decoration: underline;
        text-decoration-color: currentcolor;
      }
    }

    /* on phones, and on phones held sideways, the header scrolls away with the page */
    @media (--below-sm), (--landscape-short) {
      .site-header {
        position: relative;
      }
    }

    @media (--below-sm) {
      .nav ul {
        gap: 0 var(--space-l);
      }

      .nav a {
        font-size: var(--text-small);
      }
    }
  }
</style>

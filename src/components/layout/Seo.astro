---
import { site } from "~/lib/site";

/**
 * Search and social metadata: canonical URL, Open Graph and Twitter cards with a designed
 * 1200×630 image per page (public/og/, made by scripts/brand-assets.mjs), and JSON-LD.
 */
interface Props {
  title: string;
  description: string;
  /** File name in public/og/, without extension. */
  og: string;
  type?: "website" | "article" | undefined;
  /** False for a page that has no address of its own (the 404 is served at any URL). */
  canonical?: boolean;
}
const { title, description, og, type = "website", canonical: hasCanonical = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const image = new URL(`/og/${og}.png`, site.url).href;

const person = {
  "@type": "Person",
  "@id": `${site.url}/#person`,
  name: site.name,
  url: `${site.url}/`,
  email: `mailto:${site.email}`,
  jobTitle: site.jobTitle,
  worksFor: { "@type": "Organization", name: site.employer },
  address: { "@type": "PostalAddress", addressLocality: site.city, addressCountry: "NL" },
  sameAs: [site.linkedin, site.github],
};
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    person,
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: `${site.url}/`,
      name: site.name,
      author: { "@id": person["@id"] },
      inLanguage: "en",
    },
  ],
};
---

{hasCanonical && <link rel="canonical" href={canonical} />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{hasCanonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="en_GB" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="author" content={site.name} />
<script type="application/ld+json" set:html={JSON.stringify(graph)} />

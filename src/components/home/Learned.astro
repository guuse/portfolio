---
import { list } from "~/lib/content";
import DefList from "~/components/ui/DefList.astro";
import Section from "~/components/ui/Section.astro";

const principles = await list("principles");
---

<Section id="learned" title="What I’ve learned">
  <DefList items={principles.map((data) => ({ term: data.title, detail: data.text }))} />
</Section>

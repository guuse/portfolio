---
import Arrow from "~/components/ui/Arrow.astro";
import { Picture } from "astro:assets";
import { list } from "~/lib/content";
import Drawing from "~/components/art/Drawing.astro";
import { card } from "~/lib/art";
import { caseStudyHref, liveArt } from "~/lib/projects";
import mtgCover from "~/assets/covers/mtg-card.webp";

const projects = await list("projects");
/* Platform and homelab get their live miniature; the MTG card is a collage of the app homes. */
---

<section class="wrap strip" id="projects" aria-labelledby="projects-title">
  <div class="strip__head">
    <h2 class="strip__h" id="projects-title">
      Projects
    </h2>
    <a class="strip__all" href="/projects/">
      All projects <Arrow />
    </a>
  </div>
  <ul class="covers" role="list">
    {projects.map((data) => {
      const live = data.id === "mtg-suite" ? null : liveArt[data.id];
      return (
        <li class="cover">
          <a class:list={["cover__link", !live && "cover__link--photo"]} href={caseStudyHref(data.id)}>
            {live ? (
              <span class="cover__art" data-card={live.motion}>
                <Drawing svg={card(live.card)} class={`vt-art--${data.id}`} />
              </span>
            ) : (
              <Picture
                class="cover__img"
                src={mtgCover}
                alt=""
                widths={[400, 800, 1200]}
                sizes="(width < 700px) 100vw, 380px"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
              />
            )}
            <span class="cover__text">
              {/* the title comes first in the link's name; the meta line still shows above it */}
              <span class="cover__title">{data.title}</span>
              <span class="cover__meta">{data.meta}</span>
              <span class="cover__line">{data.card}</span>
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</section>

<style>
  @layer components {
    .strip {
      padding-block: clamp(2rem, 1rem + 3vw, 3.5rem) clamp(3rem, 2rem + 3vw, 5rem);
    }

    .strip__head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.25rem;
    }

    .strip__h {
      font-family: var(--font-heading);
      font-size: var(--text-h2);
      line-height: 1;
    }

    .strip__all {
      font-weight: 500;
    }

    .covers {
      display: grid;
      gap: var(--space-gutter);
      grid-template-columns: minmax(0, 1fr);
    }

    @media (--md) {
      .covers {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .cover__link {
      position: relative;
      isolation: isolate;
      display: block;
      aspect-ratio: 4 / 5;
      border-radius: var(--radius-s);
      border: 1px solid var(--line);
      overflow: hidden;
      text-decoration: none;
      color: var(--ink);
      transition:
        transform var(--duration-base) var(--ease-out),
        border-color var(--duration-base) var(--ease-out);
    }

    /* a card lifts a little and takes the accent edge; pressing it (touch too) gives way */
    .cover__link:focus-visible {
      transform: translate3d(0, -3px, 0);
      border-color: var(--accent);
      outline-offset: 4px;
    }

    @media (hover: hover) {
      .cover__link:hover {
        transform: translate3d(0, -3px, 0);
        border-color: var(--accent);
        color: var(--ink);
      }

      .cover__link--photo:hover :global(.cover__img) {
        animation: shuffle 1.6s var(--ease-in-out) infinite;
      }
    }

    .cover__link:active {
      transform: translate3d(0, -1px, 0) scale(0.985);
      transition-duration: var(--duration-quick);
    }

    .cover__link::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        transparent 50%,
        color-mix(in oklch, var(--surface) 94%, transparent) 86%
      );
    }

    .cover__art {
      position: absolute;
      inset: 0;
      display: block;
      background: var(--surface-card);
    }

    .cover__art :global(.scene-svg) {
      width: 100%;
      height: 100%;
    }

    /* the collage drifts with scroll (src/scripts/scroll-effects.ts) and shuffles on hover */
    .cover__link :global(.cover__img) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 20%;
      background: var(--surface-card);
      will-change: transform;
      transition: transform 120ms linear;
    }

    /*
     * The collage shuffles while the card is hovered or focused. It moves the image with the
     * `translate` property, which composites (object-position repainted every frame) and
     * composes with the parallax `transform` that scroll-effects.ts sets.
     */
    .cover__link--photo:focus-visible :global(.cover__img) {
      animation: shuffle 1.6s var(--ease-in-out) infinite;
    }

    @keyframes shuffle {
      0%,
      100% {
        translate: 0 0;
      }

      50% {
        translate: 1% -1%;
      }
    }

    .cover__text {
      position: absolute;
      inset: auto 0 0;
      z-index: 1;
      padding: 1.25rem 1.4rem 1.4rem;
      display: grid;
      gap: var(--space-2xs);
    }

    .cover__meta {
      order: -1;
      font-size: var(--text-small);
      color: var(--ink-subtle);
    }

    .cover__title {
      font-family: var(--font-heading);
      font-size: var(--text-card-title);
      line-height: 1.05;
    }

    .cover__line {
      color: var(--ink-muted);
      font-size: var(--text-small);
      line-height: 1.4;
    }

    @media (--below-md) {
      .cover__link :global(.cover__img) {
        object-position: center;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .cover__link--photo:is(:hover, :focus-visible) :global(.cover__img) {
        animation: none;
      }

      .cover__link:is(:hover, :focus-visible, :active) {
        transform: none;
      }
    }
  }
</style>

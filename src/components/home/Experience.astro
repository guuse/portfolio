---
import { list } from "~/lib/content";
import Section from "~/components/ui/Section.astro";

const phases = await list("experience");
---

<Section id="experience" title="Experience">
  <div class="org">
    <h3 class="org__name">Harborn</h3>
    <p class="org__where">Digital agency, Rotterdam and Amsterdam</p>
  </div>
  {/* the timeline line draws itself as you read and fills each dot it reaches: the line's
       transform and .is-reached are set by src/scripts/scroll-effects.ts */}
  <div class="timeline">
    <span class="timeline__line" aria-hidden="true"></span>
    <ol class="phases" role="list">
      {phases.map((data) => (
        <li class="phase">
          <h4 class="phase__title">
            {data.title} <span class="phase__years">{data.years}</span>
          </h4>
          <p class="phase__intro">{data.intro}</p>
          <ul>
            {data.bullets.map((b) => (
              <li set:html={b} />
            ))}
          </ul>
          {data.learned && <p class="phase__learned">{data.learned}</p>}
        </li>
      ))}
    </ol>
  </div>
</Section>

<style>
  @layer components {
    .org {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-2xs) var(--space-l);
      padding-bottom: 0.25rem;
    }

    .org__name {
      font-family: var(--font-heading);
      font-size: var(--text-h3);
      line-height: 1.2;
    }

    .org__where {
      color: var(--ink-muted);
    }

    .timeline {
      position: relative;
    }

    .phases {
      position: relative;
      display: grid;
      padding-left: 26px;
    }

    .phases::before,
    .timeline__line {
      content: "";
      position: absolute;
      left: 4px;
      top: 0.9rem;
      bottom: 0.5rem;
      width: 1px;
      background: var(--line);
    }

    /*
     * The accent over the grey track: an element of its own, so the script scales it directly
     * (transform only) without restyling the list. Without JavaScript it is drawn in full.
     */
    .timeline__line {
      z-index: 1;
      background: var(--accent);
      transform-origin: center top;
      pointer-events: none;
    }

    /* on paper the line is drawn in full, wherever the scroll left it */
    @media print {
      .timeline__line {
        transform: none !important;
      }
    }

    .phase {
      position: relative;
      padding-block: 1.25rem;
      border-top: 1px solid var(--line);
      display: grid;
      gap: 0.5rem;
    }

    .phase:first-child {
      border-top: 0;
      padding-top: 0.5rem;
    }

    /*
     * Each phase's dot: a ring (::before), and the accent fill over it (::after) that fades and
     * grows in once the line has reached it (.is-reached, src/scripts/scroll-effects.ts).
     * Only opacity and transform change, so the browser animates them off the main thread.
     */
    .phase::before,
    .phase::after {
      content: "";
      position: absolute;
      left: -26px;
      top: 1.75rem;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--surface);
      border: 1.5px solid var(--line-strong);
      transition: transform var(--duration-slow) var(--ease-spring);
    }

    .phase::after {
      background: var(--accent);
      border-color: var(--accent);
      opacity: 0;
      transition:
        opacity var(--duration-base) var(--ease-out),
        transform var(--duration-slow) var(--ease-spring);
    }

    .phase:first-child::before,
    .phase:first-child::after {
      top: 0.95rem;
      border-color: var(--accent);
    }

    .phase:global(.is-reached)::before {
      transform: scale(1.15);
    }

    .phase:global(.is-reached)::after {
      opacity: 1;
      transform: scale(1.15);
    }

    .phase__title {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-2xs) 10px;
      font-size: var(--text-lead);
      font-weight: 600;
      letter-spacing: -0.005em;
    }

    .phase__years {
      font-weight: 400;
      font-size: var(--text-small);
      color: var(--ink-subtle);
      font-variant-numeric: tabular-nums lining-nums;
      white-space: nowrap;
    }

    .phase__intro {
      color: var(--ink-muted);
      max-width: var(--size-measure);
    }

    .phase ul {
      padding-left: 1.1em;
      display: grid;
      gap: 0.4rem;
      margin-top: 0.25rem;
      max-width: var(--size-measure);
    }

    .phase li::marker {
      color: var(--ink-subtle);
    }

    .phase li :global(a) {
      white-space: nowrap;
    }

    .phase__learned {
      margin-top: 0.4rem;
      max-width: var(--size-measure);

      /* a synthesised italic: the real one would be 50 KB of font for four short lines */
      font-size: var(--text-small);
      font-style: italic;
      color: var(--ink-subtle);
    }

    @media (prefers-reduced-motion: reduce) {
      .phases::after {
        transform: none;
      }
    }
  }
</style>

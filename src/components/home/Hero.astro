---
import { Picture } from "astro:assets";
import CopyButton from "~/components/ui/CopyButton.astro";
import TextLink from "~/components/ui/TextLink.astro";
import { emailHtml, site } from "~/lib/site";
import bouldering from "~/assets/photos/bouldering.webp";
import portrait from "~/assets/photos/portrait.webp";
import sunset from "~/assets/photos/sunset.webp";

/** Real numbers only; they're repeated in the experience and project copy. */
const stats = [
  ["10+", "years"],
  ["8", "clusters"],
  ["1,500+", "pods"],
  ["CKA", "certified"],
] as const;
---

<section class="stage" aria-labelledby="hero-title">
  <div class="stage__bg" data-print="bouldering">
    {/*
      the backdrop covers the whole stage, so it is the viewport's width at every size. It is
      the homepage's LCP, under a 45-90% overlay, so quality 30 is plenty; the prints load at
      low priority, after it and the two fonts
    */}
    <Picture
      src={bouldering}
      alt=""
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={[480, 750, 900]}
      sizes="100vw"
      quality={30}
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="wrap stage__inner">
    <div class="stage__text">
      <p class="stage__kicker">
        {site.name} · {site.city}
      </p>
      <h1 class="stage__title" id="hero-title">
        I like building things that keep running.
      </h1>
      <p class="stage__role">Tech lead infrastructure &amp; platform engineering at Harborn</p>
      <p class="stage__intro">
        I’m Guus. I lead the infrastructure team at Harborn, a digital agency in Rotterdam, where I build and
        run the platform our client projects live on: Kubernetes, GitOps and infrastructure as code on AWS and
        Azure. Ten years in, and I still write code most days.
      </p>
      <dl class="stats">
        {stats.map(([value, label]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
      <div class="actions">
        <TextLink variant="outline" href="/projects/">
          See projects <span aria-hidden="true">&rarr;</span>
        </TextLink>
        <span class="actions__mail">
          <a class="email" id="mail-top" href={`mailto:${site.email}`} set:html={emailHtml} />
          <CopyButton target="mail-top" label="Copy email" />
        </span>
        <TextLink variant="underline" href={site.linkedin} external>
          LinkedIn
        </TextLink>
        <TextLink variant="underline" href={site.github} external>
          GitHub
        </TextLink>
      </div>
    </div>
    <div class="stage__prints">
      <figure class="print print--portrait" data-print="me">
        <Picture
          src={portrait}
          alt="Guus Ekkelenkamp"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[340, 680]}
          sizes="(width < 1000px) 220px, 340px"
          loading="eager"
          fetchpriority="low"
        />
      </figure>
      <figure class="print print--a" data-print="travel">
        <Picture
          src={sunset}
          alt="Guus at a railing at sunset over the water"
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[170, 340]}
          sizes="(width < 1000px) 108px, 170px"
          loading="eager"
          fetchpriority="low"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  @layer components {
    /* Full-bleed: the hero reaches past the page gutter and slides under the header. */
    .stage {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      min-height: min(92svh, 900px);
      display: grid;
      align-items: center;
      margin: calc(-1 * var(--space-header)) calc(-1 * var(--space-edge-end)) 0 calc(-1 * var(--space-edge));
      padding: var(--space-header) var(--space-edge-end) 0 var(--space-edge);
    }

    .stage__bg {
      position: absolute;
      inset: 0;
      z-index: -1;
      user-select: none;
    }

    .stage__bg :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 40%;
    }

    .stage__bg::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          90deg,
          var(--surface) 0%,
          color-mix(in oklch, var(--surface) 90%, transparent) 40%,
          color-mix(in oklch, var(--surface) 45%, transparent) 72%,
          color-mix(in oklch, var(--surface) 60%, transparent) 100%
        ),
        linear-gradient(180deg, transparent 55%, var(--surface) 100%);
      transition: opacity var(--duration-slow) var(--ease-out);
    }

    /* hovering "Bouldering" brightens the backdrop */
    .stage__bg:global(.is-lifted)::after {
      opacity: 0.45;
    }

    .stage__inner {
      display: grid;
      gap: 2.5rem var(--space-gutter);
      align-items: center;
      padding-block: clamp(2rem, 1rem + 5vw, 5rem);
    }

    .stage__kicker {
      color: var(--ink-subtle);
      font-size: var(--text-small);
    }

    .stage__title {
      margin-top: 1rem;
      font-family: var(--font-heading);
      font-size: var(--text-display);
      line-height: 0.95;
      letter-spacing: -0.02em;
      max-width: 10.5em;
    }

    .stage__role {
      margin-top: 1.2rem;
      font-size: var(--text-lead);
      font-weight: 500;
    }

    .stage__intro {
      margin-top: 0.8rem;
      max-width: var(--size-measure);
      color: var(--ink-muted);
    }

    .stats {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem 2.4rem;
      margin-top: 1.8rem;
    }

    .stats div {
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
    }

    .stats div + div {
      padding-left: 2.4rem;
      border-left: 1px solid var(--line);
    }

    .stats dd {
      font-family: var(--font-heading);
      font-size: var(--text-stat);
      line-height: 1;
      font-variant-numeric: lining-nums;
    }

    .stats dt {
      font-size: var(--text-small);
      color: var(--ink-subtle);
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px 18px;
      margin-top: 2rem;
      width: fit-content;
      max-width: 100%;
    }

    .actions__mail {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-s);
    }

    .email {
      user-select: all;
      font-weight: 500;
      text-decoration: none;
    }

    @media (hover: hover) {
      .email:hover {
        text-decoration: underline;
      }
    }

    /* a finger needs a 44px target */
    @media (pointer: coarse) {
      .email {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
      }
    }

    /* the prints: loose photos, tilted, that straighten when lifted */
    .stage__prints {
      position: relative;
      aspect-ratio: 1;
      width: min(100%, 460px);
      justify-self: center;
    }

    .print {
      --tilt: 0deg;

      position: absolute;
      margin: 0;
      padding: clamp(5px, 0.7vw, 9px);
      background: var(--paper);
      cursor: grab;
      user-select: none;
      touch-action: pan-y;
      box-shadow: 0 10px 30px var(--shadow-print);
      transform: translate(var(--dx, 0), var(--dy, 0)) rotate(var(--tilt));
      transition:
        transform var(--duration-slow) var(--ease-spring),
        box-shadow var(--duration-base) var(--ease-out);

      /*
       * The prints drop in once, after the text. "backwards" so that once it's over the
       * animation no longer holds the transform (hover and drag own it), and nothing ever
       * toggles `animation` again: src/scripts/prints.ts marks each print .is-settled on
       * animationend, which retires it for good. (Toggling it used to restart the drop.)
       */
      animation: settle 900ms var(--ease-out) calc(var(--duration-stagger) * 6) backwards;
    }

    .print :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      pointer-events: none;
      -webkit-user-drag: none;
    }

    .print--portrait {
      --tilt: 2deg;

      left: 18%;
      top: 4%;
      width: 74%;
      aspect-ratio: 1;
      z-index: 2;
    }

    .print--a {
      --tilt: -7deg;

      left: 0;
      top: 46%;
      width: 36%;
      aspect-ratio: 3 / 4;
      z-index: 3;
      animation-delay: calc(var(--duration-stagger) * 6 + 220ms);
    }

    /* lifted under a mouse or pen only: on touch a tap would leave it stuck in the air */
    @media (hover: hover) {
      .print:hover {
        transform: translate(var(--dx, 0), var(--dy, 0)) rotate(0deg) translateY(-8px) scale(1.04);
        z-index: 5;
        box-shadow: 0 18px 44px var(--shadow-print-lifted);
      }
    }

    /* lifted by its interest in About (src/scripts/prints.ts) */
    .print:global(.is-lifted) {
      transform: translate(var(--dx, 0), var(--dy, 0)) rotate(0deg) translateY(-8px) scale(1.04);
      z-index: 5;
      box-shadow:
        0 18px 44px var(--shadow-print-lifted),
        0 0 0 1px var(--accent);
    }

    .print:global(.is-dragging) {
      transition: none;
      cursor: grabbing;
      z-index: 6;
    }

    .print:global(.is-settled) {
      animation: none;
    }

    /* the Konami untap (src/scripts/eggs.ts), here so it outranks .is-settled */
    :global(.is-untapping) .print {
      animation: untap var(--duration-untap) var(--ease-in-out);
    }

    /*
     * The text arrives first, one line after another. The heading starts nearly visible, so
     * it paints at once and never holds back the page's first paint.
     */
    .stage__text > * {
      animation: rise var(--duration-reveal) var(--ease-out) backwards;
    }

    .stage__text > .stage__title {
      animation-name: rise-soft;
      animation-delay: var(--duration-stagger);
    }

    .stage__text > .stage__role {
      animation-delay: calc(var(--duration-stagger) * 2);
    }

    .stage__text > .stage__intro {
      animation-delay: calc(var(--duration-stagger) * 3);
    }

    .stage__text > .stats {
      animation-delay: calc(var(--duration-stagger) * 4);
    }

    .stage__text > .actions {
      animation-delay: calc(var(--duration-stagger) * 5);
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translate3d(0, 12px, 0);
      }
    }

    @keyframes rise-soft {
      from {
        opacity: 0.4;
        transform: translate3d(0, 8px, 0);
      }
    }

    @keyframes settle {
      from {
        opacity: 0;
        transform: translate3d(0, -18px, 0) rotate(calc(var(--tilt) + 5deg)) scale(1.04);
      }

      to {
        opacity: 1;
        transform: translate(var(--dx, 0), var(--dy, 0)) rotate(var(--tilt));
      }
    }

    @media (--lg) {
      .stage__inner {
        grid-template-columns: minmax(0, 7.5fr) minmax(0, 3.5fr);
      }
    }

    @media (--below-lg) {
      .stage {
        min-height: 0;
      }

      .stage__bg::after {
        background: linear-gradient(
          180deg,
          color-mix(in oklch, var(--surface) 35%, transparent) 0%,
          color-mix(in oklch, var(--surface) 85%, transparent) 38%,
          var(--surface) 70%
        );
      }

      .stage__prints {
        order: -1;
        width: min(100%, 300px);
        justify-self: start;
      }
    }

    /*
     * A phone held sideways: text on the left, the prints beside it at about 40%, so the name
     * and the headline are on the first screen instead of under the photos.
     */
    @media (--landscape-short) and (--below-lg) {
      .stage__inner {
        grid-template-columns: minmax(0, 6fr) minmax(0, 4fr);
        align-items: start;
        padding-block: 1.25rem 2rem;
      }

      .stage__prints {
        order: 0;
        width: min(100%, calc(100svh - 96px));
        justify-self: center;
      }

      .stage__title {
        font-size: min(var(--text-display), 9svh + 1rem);
      }

      .stage__bg::after {
        background: linear-gradient(
          90deg,
          var(--surface) 0%,
          color-mix(in oklch, var(--surface) 88%, transparent) 50%,
          color-mix(in oklch, var(--surface) 50%, transparent) 100%
        );
      }
    }

    @media (--below-sm) {
      .stats {
        gap: 1rem 1.4rem;
      }

      .stats div + div {
        padding-left: 1.4rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .print,
      .stage__text > * {
        transition: none;
        animation: none;
      }
    }
  }
</style>

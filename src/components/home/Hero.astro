---
import Arrow from "~/components/ui/Arrow.astro";
import { Picture } from "astro:assets";
import CopyButton from "~/components/ui/CopyButton.astro";
import TextLink from "~/components/ui/TextLink.astro";
import { emailHtml, site } from "~/lib/site";
import bouldering from "~/assets/photos/bouldering.webp";
import portrait from "~/assets/photos/portrait.webp";
import sunset from "~/assets/photos/sunset.webp";

/** Real numbers only; they're repeated in the experience and project copy. */
const stats = [
  ["10+", "years"],
  ["8", "clusters"],
  ["1,500+", "pods"],
  ["CKA", "certified"],
] as const;
---

<div class="hero">
  <section class="stage" aria-labelledby="hero-title">
    <div class="stage__bg" data-print="bouldering">
      {/*
        the backdrop covers the whole stage, so it is the viewport's width at every size. It is
        the homepage's LCP, under a 45-90% overlay, so quality 30 is plenty; the prints load at
        low priority, after it and the two fonts
      */}
      <Picture
        src={bouldering}
        alt=""
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        widths={[480, 750, 900]}
        sizes="100vw"
        quality={30}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="wrap stage__inner">
      <div class="stage__text">
        <p class="stage__kicker">
          {site.name} · {site.city}
        </p>
        <h1 class="stage__title" id="hero-title">
          I like building things that keep running.
        </h1>
        <p class="stage__role">Tech lead infrastructure at Harborn</p>
        <p class="stage__intro">
          I’m Guus. I lead the infrastructure team at Harborn, a digital agency in Rotterdam, where I build
          and look after the platform our client projects run on: Kubernetes, GitOps and infrastructure as
          code on AWS and Azure. I’ve been at Harborn since 2016 and I still write code most days.
        </p>
        <dl class="stats">
          {stats.map(([value, label]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
        {/* three groups that wrap whole: the way in, the address with its copy button, the profiles */}
        <div class="actions">
          <TextLink variant="outline" href="/projects/" class="actions__go">
            See projects <Arrow />
          </TextLink>
          <span class="mailbox">
            <a class="email" id="mail-top" href={`mailto:${site.email}`} set:html={emailHtml} />
            <CopyButton target="mail-top" label="Copy email" />
          </span>
          <span class="actions__more">
            <TextLink variant="underline" href={site.linkedin} external>
              LinkedIn
            </TextLink>
            <TextLink variant="underline" href={site.github} external>
              GitHub
            </TextLink>
          </span>
        </div>
      </div>
      {/*
        The prints. With a mouse on a wide screen the rail runs from the middle of the hero to
        the end of About, and the prints are sticky in it, so they stay in view while the reader
        scrolls through About; elsewhere both wrappers are display: contents and the prints sit
        in the hero.
      */}
      <div class="stage__rail">
        <div class="stage__col">
          <div class="stage__prints">
            <figure class="print print--portrait" data-print="me">
              <Picture
                src={portrait}
                alt="Guus Ekkelenkamp"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                widths={[340, 680]}
                sizes="(width < 1000px) 220px, 340px"
                loading="eager"
                fetchpriority="low"
              />
            </figure>
            <figure class="print print--a" data-print="travel">
              <Picture
                src={sunset}
                alt="Guus at a railing at sunset over the water"
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                widths={[170, 340]}
                sizes="(width < 1000px) 108px, 170px"
                loading="eager"
                fetchpriority="low"
              />
            </figure>
            {/*
              the backdrop again, as a print that comes out from behind the portrait while
              "Bouldering" is hovered (by then the backdrop has scrolled away). Only the pinned
              stage shows it, so elsewhere this lazy image is never fetched.
            */}
            <figure class="print print--b" data-print="bouldering" aria-hidden="true">
              <Picture
                src={bouldering}
                alt=""
                formats={["avif", "webp"]}
                fallbackFormat="webp"
                widths={[180, 360]}
                sizes="180px"
                loading="lazy"
                fetchpriority="low"
              />
            </figure>
          </div>
        </div>
      </div>
    </div>
  </section>
  <slot />
</div>

<style>
  @layer components {
    /* the hero and About (the slot): the pinned prints' rail runs the height of both */
    .hero {
      display: flow-root;
    }

    /*
     * Full-bleed: the hero reaches past the page gutter and slides under the header. It is
     * not positioned (the backdrop is a grid item laid under the text instead), so the pinned
     * prints' rail can be positioned by .hero, and it clips without being a scroll container,
     * which would hold anything sticky inside it.
     */
    .stage {
      isolation: isolate;
      overflow: clip;
      min-height: min(92svh, 900px);
      display: grid;
      align-items: center;
      margin: calc(-1 * var(--space-header)) calc(-1 * var(--space-edge-end)) 0 calc(-1 * var(--space-edge));
      padding: var(--space-header) var(--space-edge-end) 0 var(--space-edge);
    }

    .stage > * {
      grid-area: 1 / 1;
    }

    /* the stage's whole box, its padding included; the photo's own height never sizes it */
    .stage__bg {
      position: relative;
      contain: size;
      z-index: -1;
      align-self: stretch;
      margin: calc(-1 * var(--space-header)) calc(-1 * var(--space-edge-end)) 0 calc(-1 * var(--space-edge));
      user-select: none;
    }

    .stage__bg :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 40%;
    }

    .stage__bg::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          90deg,
          var(--surface) 0%,
          color-mix(in oklch, var(--surface) 90%, transparent) 40%,
          color-mix(in oklch, var(--surface) 45%, transparent) 72%,
          color-mix(in oklch, var(--surface) 60%, transparent) 100%
        ),
        linear-gradient(180deg, transparent 55%, var(--surface) 100%);
      transition: opacity var(--duration-slow) var(--ease-out);
    }

    /* hovering "Bouldering" brightens the backdrop */
    .stage__bg:global(.is-lifted)::after {
      opacity: 0.45;
    }

    .stage__inner {
      display: grid;
      gap: 2.5rem var(--space-gutter);
      align-items: center;
      padding-block: clamp(2rem, 1rem + 5vw, 5rem);
    }

    .stage__kicker {
      color: var(--ink-subtle);
      font-size: var(--text-small);
    }

    .stage__title {
      margin-top: 1rem;
      font-family: var(--font-heading);
      font-size: var(--text-display);
      line-height: 0.95;
      letter-spacing: -0.02em;
      max-width: 10.5em;
    }

    .stage__role {
      margin-top: 1.2rem;
      font-size: var(--text-lead);
      font-weight: 500;
    }

    .stage__intro {
      margin-top: 0.8rem;
      max-width: var(--size-measure);
      color: var(--ink-muted);
    }

    .stats {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem 2.4rem;
      margin-top: 1.8rem;
    }

    .stats div {
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
    }

    .stats div + div {
      padding-left: 2.4rem;
      border-left: 1px solid var(--line);
    }

    .stats dd {
      font-family: var(--font-heading);
      font-size: var(--text-stat);
      line-height: 1;
      font-variant-numeric: lining-nums;
    }

    .stats dt {
      font-size: var(--text-small);
      color: var(--ink-subtle);
    }

    /*
     * The actions: three groups on one 44px line and one centre line, each kept whole when
     * the row wraps. The way in is the one solid button; the address and its copy button
     * share one outline; the profiles are quiet links.
     */
    .actions {
      --action-h: var(--size-touch);

      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-m) var(--space-xl);
      margin-top: 2rem;
      font-size: var(--text-small);
      line-height: 1.2;
    }

    .actions > * {
      flex: none;
      max-width: 100%;
    }

    .actions :global(.actions__go) {
      height: var(--action-h);
      padding: 0 var(--space-m) 0 var(--space-l);
      gap: var(--space-s);
      border: 0;
      background: var(--ink);
      color: var(--surface);
      font-size: var(--text-body);
      transition: background-color var(--duration-quick);
    }

    @media (hover: hover) {
      .actions :global(.actions__go:hover) {
        background: var(--accent);
        color: var(--accent-ink);
      }
    }

    /*
     * The outline is an inset outline, not a border, so the address and the copy button
     * inside it are the full 44px tall. On a very narrow window (400% zoom) the address
     * wraps at the @ and the button keeps its square.
     */
    .mailbox {
      display: inline-flex;
      align-items: stretch;
      min-height: var(--action-h);
      outline: 1px solid var(--line-strong);
      outline-offset: -1px;
      border-radius: var(--radius-s);
    }

    .email {
      display: inline-flex;
      align-items: center;
      min-width: 0;
      min-height: var(--action-h);
      padding: 0 var(--space-m);
      overflow-wrap: anywhere;
      border-radius: var(--radius-s) 0 0 var(--radius-s);
      user-select: all;
      font-weight: 500;
      text-decoration: none;
    }

    @media (hover: hover) {
      .email:hover {
        text-decoration: underline;
      }
    }

    /*
     * The copy button is the outline's second half, behind a hairline: a square icon. Its
     * label (whichever state it's in, still its accessible name) is a small tag above it,
     * shown on hover or focus and while it says "Copied" or "Selected"; it never takes room
     * in the row, so the button keeps its width whatever it says.
     */
    .mailbox :global(.copy) {
      position: relative;
      flex: none;
      justify-content: center;
      width: var(--action-h);
      min-height: var(--action-h);
      padding: 0;
      border: 0;
      border-inline-start: 1px solid var(--line-strong);
      border-radius: 0 var(--radius-s) var(--radius-s) 0;
      font-size: inherit;
    }

    .mailbox :global(.copy__icon) {
      width: var(--space-l);
      height: var(--space-l);
    }

    .mailbox :global(.copy[data-state="done"]) {
      border-inline-start-color: var(--accent);
    }

    /* below the button, not above it, where the sticky header could cover it */
    .mailbox :global(.copy__labels) {
      position: absolute;
      top: calc(100% + var(--space-xs));
      left: 50%;
      z-index: 1;
      justify-items: center;
      padding: var(--space-3xs) var(--space-s);
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-xs);
      background: var(--surface-raised);
      color: var(--ink);
      font-size: var(--text-small);
      line-height: 1.4;
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      transform: translateX(-50%);
      transition: opacity var(--duration-quick) var(--ease-out);
    }

    .mailbox :global(.copy:focus-visible .copy__labels),
    .mailbox :global(.copy[data-state] .copy__labels) {
      opacity: 1;
    }

    @media (hover: hover) {
      .mailbox :global(.copy:hover .copy__labels) {
        opacity: 1;
      }
    }

    .actions__more {
      display: inline-flex;
      gap: var(--space-l);
    }

    .actions__more :global(.tlink) {
      min-height: var(--action-h);
      color: var(--ink-muted);
      font-weight: 400;
    }

    /* outside the pinned stage the prints are a plain grid item of the hero */
    .stage__rail,
    .stage__col {
      display: contents;
    }

    /* the prints: loose photos, tilted, that straighten when lifted */
    .stage__prints {
      position: relative;
      aspect-ratio: 1;
      width: min(100%, 460px);
      justify-self: center;
    }

    .print {
      --tilt: 0deg;

      position: absolute;
      margin: 0;
      padding: clamp(var(--space-xs), 0.7vw, var(--space-s));
      background: var(--paper);
      cursor: grab;
      user-select: none;
      touch-action: pan-y;
      box-shadow: 0 10px 30px var(--shadow-print);
      transform: translate(var(--dx, 0), var(--dy, 0)) rotate(var(--tilt));
      transition:
        transform var(--duration-slow) var(--ease-spring),
        box-shadow var(--duration-base) var(--ease-out);

      /*
       * The prints drop in once, after the text. "backwards" so that once it's over the
       * animation no longer holds the transform (hover and drag own it), and nothing ever
       * toggles `animation` again: src/scripts/prints.ts marks each print .is-settled on
       * animationend, which retires it for good. (Toggling it used to restart the drop.)
       */
      animation: settle 900ms var(--ease-out) calc(var(--duration-stagger) * 6) backwards;
    }

    .print :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      pointer-events: none;
      -webkit-user-drag: none;
    }

    .print--portrait {
      --tilt: 2deg;

      left: 18%;
      top: 4%;
      width: 74%;
      aspect-ratio: 1;
      z-index: 2;
    }

    .print--a {
      --tilt: -7deg;

      left: 0;
      top: 46%;
      width: 36%;
      aspect-ratio: 3 / 4;
      z-index: 3;
      animation-delay: calc(var(--duration-stagger) * 6 + 220ms);
    }

    /*
     * The bouldering print waits behind the portrait, unseen, and only the pinned stage has
     * it. Lifted, it slides out to the lower right and, halfway there, comes to the front;
     * let go, it goes behind the portrait first and slides back.
     */
    .print--b {
      --tilt: 6deg;

      display: none;
      left: 57%;
      top: 42%;
      width: 40%;
      aspect-ratio: 3 / 4;
      z-index: 1;
      opacity: 0;
      pointer-events: none;
      transform: translate(-30%, -24%) rotate(0deg) translateY(0) scale(0.9);
      animation: none;
      transition:
        transform var(--duration-slow) var(--ease-out),
        opacity var(--duration-base) var(--ease-out),
        z-index 0s;
    }

    .print--b:global(.is-lifted) {
      opacity: 1;
      transition:
        transform var(--duration-slow) var(--ease-spring),
        opacity var(--duration-base) var(--ease-out),
        z-index 0s linear calc(var(--duration-slow) / 2);
    }

    /* lifted under a mouse or pen only: on touch a tap would leave it stuck in the air */
    @media (hover: hover) {
      .print:hover {
        transform: translate(var(--dx, 0), var(--dy, 0)) rotate(0deg) translateY(calc(-1 * var(--space-s)))
          scale(1.04);
        z-index: 5;
        box-shadow: 0 18px 44px var(--shadow-print-lifted);
      }
    }

    /* lifted by its interest in About (src/scripts/prints.ts) */
    .print:global(.is-lifted) {
      transform: translate(var(--dx, 0), var(--dy, 0)) rotate(0deg) translateY(calc(-1 * var(--space-s)))
        scale(1.04);
      z-index: 5;
      box-shadow:
        0 18px 44px var(--shadow-print-lifted),
        0 0 0 1px var(--accent);
    }

    .print:global(.is-dragging) {
      transition: none;
      cursor: grabbing;
      z-index: 6;
    }

    .print:global(.is-settled) {
      animation: none;
    }

    /* the Konami untap (src/scripts/eggs.ts), here so it outranks .is-settled */
    :global(.is-untapping) .print {
      animation: untap var(--duration-untap) var(--ease-in-out);
    }

    /*
     * The text arrives first, one line after another. The heading starts nearly visible, so
     * it paints at once and never holds back the page's first paint.
     */
    .stage__text > * {
      animation: rise var(--duration-reveal) var(--ease-out) backwards;
    }

    .stage__text > .stage__title {
      animation-name: rise-soft;
      animation-delay: var(--duration-stagger);
    }

    .stage__text > .stage__role {
      animation-delay: calc(var(--duration-stagger) * 2);
    }

    .stage__text > .stage__intro {
      animation-delay: calc(var(--duration-stagger) * 3);
    }

    .stage__text > .stats {
      animation-delay: calc(var(--duration-stagger) * 4);
    }

    .stage__text > .actions {
      animation-delay: calc(var(--duration-stagger) * 5);
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translate3d(0, var(--space-m), 0);
      }
    }

    @keyframes rise-soft {
      from {
        opacity: 0.4;
        transform: translate3d(0, var(--space-s), 0);
      }
    }

    @keyframes settle {
      from {
        opacity: 0;
        transform: translate3d(0, calc(-1 * var(--space-l)), 0) rotate(calc(var(--tilt) + 5deg)) scale(1.04);
      }

      to {
        opacity: 1;
        transform: translate(var(--dx, 0), var(--dy, 0)) rotate(var(--tilt));
      }
    }

    @media (--lg) {
      .stage__inner {
        grid-template-columns: minmax(0, 7.5fr) minmax(0, 3.5fr);
      }
    }

    /*
     * The pinned stage, for a mouse on a wide, tall enough screen. .hero becomes a grid: the
     * hero spans two equal rows, so the line between them is its middle, and About is the
     * third. The rail (still the hero's right column, but placed on .hero's grid lines) runs
     * from that middle line to the end of About. The prints start at the top of the rail,
     * pulled up by half their height, so their centre is the hero's middle: exactly where the
     * hero has always put them. Then they are sticky: as the hero scrolls away they ride up
     * until they're centred under the header (no distance at all when the hero is one screen
     * tall), stay there through About, and leave with its end. Nothing sticky is inside
     * About, whose rendering content-visibility may skip.
     */
    @media screen and (--lg) and (--not-short) and (hover: hover) and (pointer: fine) {
      .hero {
        position: relative;
        display: grid;
        grid-template-rows: 1fr 1fr auto;
      }

      .stage {
        grid-row: 1 / 3;
      }

      .hero > :global(:not(.stage)) {
        grid-row: 3;
      }

      .stage__rail {
        position: absolute;
        inset: 0;
        grid-row: 2 / 4;
        grid-column: 1;
        display: grid;
        grid-template-columns: minmax(0, 7.5fr) minmax(0, 3.5fr);
        column-gap: var(--space-gutter);
        width: min(100%, var(--size-wrap));
        margin-inline: auto;
        pointer-events: none;
      }

      .stage__col {
        display: block;
        grid-column: 2;
        container-type: inline-size;
      }

      .stage__prints {
        --side: min(100cqi, 460px);

        position: sticky;
        top: calc(var(--space-header) + (min(92svh, 900px) - var(--space-header) - var(--side)) / 2);
        width: var(--side);
        margin: calc(var(--side) / -2) auto 0;
      }

      .print {
        pointer-events: auto;
      }

      .print--b {
        display: block;
        pointer-events: none;
      }
    }

    @media (--below-lg) {
      .stage {
        min-height: 0;
      }

      .stage__bg::after {
        background: linear-gradient(
          180deg,
          color-mix(in oklch, var(--surface) 35%, transparent) 0%,
          color-mix(in oklch, var(--surface) 85%, transparent) 38%,
          var(--surface) 70%
        );
      }

      .stage__prints {
        order: -1;
        width: min(100%, 300px);
        justify-self: start;
      }
    }

    /*
     * A phone held sideways: text on the left, the prints beside it at about 40%, so the name
     * and the headline are on the first screen instead of under the photos. Not under 480px
     * (a desktop window at 400% zoom), where two columns leave the text too little room.
     */
    @media (--landscape-short) and (--below-lg) and (--xs) {
      .stage__inner {
        grid-template-columns: minmax(0, 6fr) minmax(0, 4fr);
        align-items: start;
        padding-block: 1.25rem 2rem;
      }

      .stage__prints {
        order: 0;
        width: min(100%, calc(100svh - var(--space-header) - var(--space-2xl)));
        justify-self: center;
      }

      .stage__title {
        font-size: min(var(--text-display), 9svh + 1rem);
      }

      .stage__bg::after {
        background: linear-gradient(
          90deg,
          var(--surface) 0%,
          color-mix(in oklch, var(--surface) 88%, transparent) 50%,
          color-mix(in oklch, var(--surface) 50%, transparent) 100%
        );
      }
    }

    @media (--below-sm) {
      .stats {
        gap: 1rem 1.4rem;
      }

      .stats div + div {
        padding-left: 1.4rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .print,
      .print--b:global(.is-lifted),
      .stage__text > *,
      .mailbox :global(.copy__labels) {
        transition: none;
        animation: none;
      }
    }
  }
</style>

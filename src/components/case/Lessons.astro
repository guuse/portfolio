---
/** Plain lesson rows: a short heading sentence and what happened. */
interface Props {
  items: { title: string; text: string }[];
}
const { items } = Astro.props;
---

<ul class="lessons rows reveal-set" role="list">
  {items.map((it, i) => (
    <li data-i={i}>
      <p class="lessons__h" set:html={it.title} />
      <p>{it.text}</p>
    </li>
  ))}
</ul>

<style>
  @layer components {
    .lessons {
      display: grid;
      max-width: 46em;
      border-top: 1px solid var(--line);
    }

    .lessons li {
      position: relative;
      display: grid;
      gap: 0.25rem;
      padding-block: 1rem;
    }

    /* the hairline under each lesson; a pseudo-element so it can draw in (src/styles/motion.css) */
    .lessons li::before {
      content: "";
      position: absolute;
      inset: auto 0 0;
      height: 1px;
      background: var(--line);
      transform-origin: left;
    }

    .lessons__h {
      font-weight: 600;
    }

    .lessons li p:not(.lessons__h) {
      max-width: var(--size-measure);
      color: var(--ink-muted);
    }
  }
</style>

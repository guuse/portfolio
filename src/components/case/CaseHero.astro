---
import Arrow from "~/components/ui/Arrow.astro";
import Drawing from "~/components/art/Drawing.astro";
import { card } from "~/lib/art";
import { liveArt, type ProjectId } from "~/lib/projects";

/**
 * The top of a case study: the project's live drawing (the same one as on its cards, so a
 * view transition carries it here) and the title. The text never sits on the drawing: on a
 * wide screen the drawing stands on the right and the text keeps to its own column; narrower,
 * the drawing goes on top; on a phone held sideways, beside the text again. Without JS or with
 * reduced motion the drawing is its still.
 *
 * The view transition names the <svg> itself (motion.css), so the morphing box has the
 * drawing's own shape on every page; the copy has a name of its own and fades in over it.
 */
interface Props {
  project: ProjectId;
  meta: string;
  title: string;
  line: string;
}
const { project, meta, title, line } = Astro.props;
const art = liveArt[project];
---

<header class={`ph-hero ph-hero--${art.card}`} data-card-host>
  <div class="ph-hero__art" data-card={art.motion}>
    <Drawing svg={card(art.card)} class={`vt-art--${project}`} />
  </div>
  <div class="ph-hero__text">
    <a class="back" href="/projects/">
      <Arrow dir="left" /> All projects
    </a>
    <p class="ph-meta">
      {meta}
      <slot name="meta" />
    </p>
    <h1 class="ph-title">{title}</h1>
    <p class="ph-line">{line}</p>
  </div>
</header>

<style>
  @layer components {
    .ph-hero {
      /* the platform and homelab drawings are 4:5 cards; the MTG one is the whole table */
      --art-ratio: 0.8;
      --art-h: clamp(340px, 46vw, 600px);

      display: grid;
      overflow: hidden;
      margin-top: 1.5rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-s);
      background: var(--surface-card);
    }

    .ph-hero--mtg {
      --art-ratio: calc(600 / 440);
    }

    /*
     * Stacked (up to the lg breakpoint): the drawing on top, small enough that the title is on
     * the first screen too, and the text under it.
     */
    .ph-hero__art {
      display: flex;
      justify-content: center;
      height: min(clamp(200px, 58vw, 320px), 45svh);
      padding-top: var(--space-m);
      overflow: hidden;
    }

    .ph-hero__art :global(.scene-svg) {
      flex: none;
      width: auto;
      height: 100%;
    }

    /*
     * The 4:5 card drawings keep their lower part for the homepage card's text: the drawing
     * itself ends at about 58% of the card's height, so the stacked hero shows the top 62%.
     */
    .ph-hero__art :global(:is(.scene--scale, .scene--cardloop)) {
      height: 160%;
    }

    .ph-hero__text {
      display: grid;
      gap: 0.6rem;
      justify-items: start;
      padding: 0.25rem clamp(1.25rem, 1rem + 2vw, 2.5rem) clamp(1.25rem, 1rem + 2vw, 2.5rem);
    }

    /*
     * Wide: the drawing on the right at the hero's full height (the MTG table at most about
     * half the hero's width), and the text in the column left of it, so it never covers it.
     */
    @media (--lg) {
      .ph-hero {
        container-type: inline-size;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        min-height: var(--art-h);
      }

      .ph-hero__art {
        grid-area: 1 / 2;
        align-self: center;
        height: auto;
        padding: 0 clamp(0px, 4vw, var(--space-3xl)) 0 0;
        overflow: visible;
      }

      .ph-hero__art :global(.scene-svg),
      .ph-hero__art :global(:is(.scene--scale, .scene--cardloop)) {
        width: min(var(--art-h) * var(--art-ratio), 52cqi);
        height: auto;
      }

      .ph-hero__text {
        grid-area: 1 / 1;
        padding: clamp(1.25rem, 1rem + 2vw, 2.5rem);
      }
    }

    /* a phone held sideways: the text on the left, the drawing beside it, the title on screen */
    @media (--landscape-short) and (--below-lg) {
      .ph-hero {
        grid-template-columns: minmax(0, 6fr) minmax(0, 4fr);
        align-items: center;
      }

      .ph-hero__art {
        grid-area: 1 / 2;
        height: min(calc(100svh - 8rem), 320px);
        padding: var(--space-s) var(--space-s) 0 0;
      }

      .ph-hero__text {
        grid-area: 1 / 1;
        gap: 0.4rem;
        padding: var(--space-s) 0 var(--space-m) var(--space-m);
      }

      .ph-title {
        font-size: min(var(--text-case-title), 9svh + 1rem);
      }
    }

    .back {
      display: inline-flex;
      align-items: center;
      gap: 0.4em;
      min-height: 40px;
      color: var(--ink-muted);
      font-size: var(--text-small);
      text-decoration: none;
    }

    @media (hover: hover) {
      .back:hover {
        color: var(--ink);
      }
    }

    .ph-meta {
      color: var(--ink-subtle);
      font-size: var(--text-small);
    }

    .ph-meta :global(a) {
      color: var(--ink-muted);
    }

    .ph-title {
      width: fit-content;
      max-width: 16em;
      font-family: var(--font-heading);
      font-size: var(--text-case-title);
      line-height: 1;
      letter-spacing: -0.02em;
    }

    .ph-line {
      max-width: 34em;
      font-size: var(--text-lead);
      line-height: 1.45;
    }
  }
</style>

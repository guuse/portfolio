---
import Drawing from "~/components/art/Drawing.astro";
import { card } from "~/lib/art";
import { liveArt, type ProjectId } from "~/lib/projects";

/**
 * The top of a case study: the project's live drawing (the same one as on its cards, so a
 * view transition carries it here) under a scrim, with the title over it. Without JS or with
 * reduced motion the drawing is its still.
 */
interface Props {
  project: ProjectId;
  meta: string;
  title: string;
  line: string;
}
const { project, meta, title, line } = Astro.props;
const art = liveArt[project];
---

<header class="ph-hero" data-card-host>
  <div class={`ph-hero__bg vt-art--${project}`} data-card={art.motion}>
    <Drawing svg={card(art.card)} />
  </div>
  <div class="ph-hero__text">
    <a class="back" href="/projects/">
      &larr; All projects
    </a>
    <p class="ph-meta">
      {meta}
      <slot name="meta" />
    </p>
    <h1 class="ph-title">{title}</h1>
    <p class="ph-line">{line}</p>
  </div>
</header>

<style>
  @layer components {
    .ph-hero {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      display: grid;
      align-items: end;
      min-height: clamp(340px, 46vw, 600px);
      margin-top: 1.5rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-s);
    }

    .ph-hero__bg {
      position: absolute;
      inset: 0;
      z-index: -1;
      display: flex;
      justify-content: flex-end;
      padding-inline-end: clamp(0px, 4vw, 48px);
      background: var(--surface-card);
    }

    /* the drawing stands as tall as the hero, on the right; the title sits over the scrim */
    .ph-hero__bg :global(.scene-svg) {
      width: auto;
      height: 100%;
    }

    .ph-hero__bg::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        0deg,
        color-mix(in oklch, var(--surface) 96%, transparent) 0%,
        color-mix(in oklch, var(--surface) 65%, transparent) 38%,
        transparent 70%
      );
    }

    /* on a phone the drawing goes on top and the title under it, so neither covers the other */
    @media (width < 700px) {
      .ph-hero {
        display: block;
        min-height: 0;
        background: var(--surface-card);
      }

      .ph-hero__bg {
        position: relative;
        z-index: 0;
        justify-content: center;
        height: clamp(200px, 58vw, 320px);
        padding: 12px 0 0;
        overflow: hidden;
      }

      .ph-hero__bg::after {
        background: linear-gradient(0deg, var(--surface-card) 0%, transparent 30%);
      }

      /* the 4:5 card drawings leave their bottom fifth for the homepage card's text: crop it */
      .ph-hero__bg :global(:is(.scene--scale, .scene--cardloop)) {
        flex: none;
        height: 125%;
      }

      .ph-hero__text {
        padding-top: 0.25rem;
      }
    }

    .ph-hero__text {
      padding: clamp(1.25rem, 1rem + 2vw, 2.5rem);
      display: grid;
      gap: 0.6rem;
      justify-items: start;
    }

    .back {
      display: inline-flex;
      align-items: center;
      min-height: 40px;
      color: var(--ink-muted);
      font-size: var(--text-small);
      text-decoration: none;
    }

    @media (hover: hover) {
      .back:hover {
        color: var(--ink);
      }
    }

    .ph-meta {
      color: var(--ink-subtle);
      font-size: var(--text-small);
    }

    .ph-meta :global(a) {
      color: var(--ink-muted);
    }

    .ph-title {
      width: fit-content;
      max-width: 16em;
      font-family: var(--font-heading);
      font-size: var(--text-case-title);
      line-height: 1;
      letter-spacing: -0.02em;
    }

    .ph-line {
      max-width: 34em;
      font-size: var(--text-lead);
      line-height: 1.45;
    }
  }
</style>

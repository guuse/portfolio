---
/** The opening paragraphs of a case study, under the hero. */
---

<div class="ph-lead">
  <slot />
</div>

<style>
  @layer components {
    .ph-lead {
      max-width: var(--size-measure);
      display: grid;
      gap: 1rem;
      margin-top: clamp(2rem, 1rem + 3vw, 3.5rem);
      padding-bottom: clamp(2rem, 1rem + 3vw, 3.5rem);
    }

    .ph-lead :global(p) {
      color: var(--ink-muted);
      font-size: var(--text-lead);
      line-height: 1.5;
    }
  }
</style>

---
import Drawing from "~/components/art/Drawing.astro";

/**
 * A small homelab diagram whose parts settle in one after another (`reveal-set`; only when it
 * starts below the fold, which is when src/scripts/reveal.ts tags it `.reveal`).
 */
interface Props {
  svg: string;
  kind: "apps" | "ways";
}
const { svg, kind } = Astro.props;
---

<figure class:list={["diagram", "reveal-set", `diagram--${kind}`]}>
  <Drawing svg={svg} />
</figure>

<style>
  @layer components {
    .diagram {
      max-width: 820px;
      margin: 1rem 0 0;
    }

    :global(.js-reveal) .diagram:global(.reveal) :global(:is(.tile, .way)) {
      opacity: 0;
      transform: translate3d(0, 8px, 0);
      transition:
        opacity var(--duration-slow) var(--ease-out),
        transform var(--duration-slow) var(--ease-out);
    }

    /* --i comes from each tile's data-i (src/scripts/reveal.ts) */
    :global(.js-reveal) .diagram:global(.reveal) :global(.tile) {
      transition-delay: calc(var(--i, 0) * var(--duration-stagger));
    }

    :global(.js-reveal) .diagram:global(.reveal) :global(.w2) {
      transition-delay: calc(var(--duration-stagger) * 4);
    }

    :global(.js-reveal) .diagram:global(.reveal) :global(.w3) {
      transition-delay: calc(var(--duration-stagger) * 8);
    }

    :global(.js-reveal) .diagram:global(.is-in) :global(:is(.tile, .way)) {
      opacity: 1;
      transform: none;
    }
  }
</style>

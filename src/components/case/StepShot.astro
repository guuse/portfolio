---
import { getImage, Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * A screenshot inside a scene step: a link to the full-size image, which the lightbox
 * (src/scripts/lightbox.ts) takes over to show it in place. Without JavaScript the link
 * simply opens the image. Its label says what it shows.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  phone?: boolean;
}
const { src, alt, caption, phone } = Astro.props;
const full = await getImage({ src, format: "webp", width: Math.min(src.width, 2880) });
---

<figure class:list={["step-shot", phone && "step-shot--phone"]}>
  <a
    class="step-shot__open"
    href={full.src}
    data-lb
    data-full-width={full.attributes["width"]}
    data-full-height={full.attributes["height"]}
    aria-label={`Enlarge: ${caption}`}
  >
    <Picture
      src={src}
      alt={alt}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={phone ? [160, 320] : [480, 960]}
      sizes={phone ? "120px" : "(width < 520px) 100vw, 480px"}
    />
  </a>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  @layer components {
    .step-shot {
      margin: 1.25rem 0 0;
      max-width: 30rem;
    }

    .step-shot__open {
      display: block;
      width: 100%;
      padding: 0;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: var(--radius-s);
      background: none;
      cursor: zoom-in;
    }

    .step-shot--phone .step-shot__open {
      border-radius: var(--radius-phone);
    }

    .step-shot :global(img) {
      width: 100%;
      height: auto;
      transition: transform var(--duration-slow) var(--ease-out);
    }

    @media (hover: hover) {
      .step-shot__open:hover :global(img) {
        transform: scale(1.02);
      }
    }

    .step-shot figcaption {
      margin-top: 0.45rem;
      color: var(--ink-subtle);
      font-size: var(--text-small);
    }
  }
</style>

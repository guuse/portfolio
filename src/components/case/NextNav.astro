---
import Arrow from "~/components/ui/Arrow.astro";
/** Previous / next between case studies. */
interface Link {
  href: string;
  small: string;
  label: string;
  /** Which way it points: the previous project is to the left, the next to the right. */
  arrow?: "left" | "right";
}
interface Props {
  prev: Link;
  next: Link;
}
const { prev, next } = Astro.props;
---

<nav class="ph-next" aria-label="More projects">
  {[prev, next].map((l) => (
    <a href={l.href}>
      <small>{l.small}</small>
      {l.arrow === "left" && <Arrow dir="left" />} {l.label} {l.arrow === "right" && <Arrow />}
    </a>
  ))}
</nav>

<style>
  @layer components {
    .ph-next {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 1rem;
      padding-block: 2.5rem;
      border-top: 1px solid var(--line);
    }

    .ph-next a {
      font-family: var(--font-heading);
      font-size: var(--text-h3);
      text-decoration: none;
    }

    @media (hover: hover) {
      .ph-next a:hover {
        color: var(--accent);
      }
    }

    .ph-next small {
      display: block;
      font-family: var(--font-body);
      font-size: var(--text-small);
      color: var(--ink-subtle);
    }
  }
</style>

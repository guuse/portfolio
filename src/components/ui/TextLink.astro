---
import type { HTMLAttributes } from "astro/types";

/**
 * The two quiet link styles. `outline` is a 1px bordered button ("See projects");
 * `underline` is a plain underlined link with room for a 40px target (LinkedIn, GitHub,
 * "Read the case study").
 */
type Props = HTMLAttributes<"a"> & { variant: "outline" | "underline"; external?: boolean };
const { variant, external, class: cls, ...rest } = Astro.props;
const ext = external ? { target: "_blank", rel: "noopener" } : {};
---

<a class:list={["tlink", `tlink--${variant}`, cls]} {...ext} {...rest}>
  <slot />
</a>

<style>
  @layer components {
    .tlink {
      display: inline-flex;
      align-items: center;
      gap: 0.45em;
      font-weight: 500;
      transition:
        border-color var(--duration-quick),
        color var(--duration-quick);
    }

    .tlink--outline {
      min-height: 44px;
      padding: 0 1rem;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-s);
      text-decoration: none;
      color: var(--ink);
    }

    .tlink--outline:hover {
      color: var(--ink);
      border-color: var(--accent);
    }

    .tlink--underline {
      min-height: 40px;
      text-decoration-color: var(--line-strong);
      text-underline-offset: 0.22em;
    }

    .tlink--underline:hover {
      color: var(--accent);
      text-decoration-color: currentcolor;
    }
  }
</style>

---
import type { HTMLAttributes } from "astro/types";
import ExternalLink from "./ExternalLink.astro";

/**
 * The two quiet link styles. `outline` is a 1px bordered button ("See projects");
 * `underline` is a plain underlined link with room for a 40px target (LinkedIn, GitHub,
 * "Read the case study").
 */
type Props = HTMLAttributes<"a"> & { variant: "outline" | "underline"; external?: boolean };
const { variant, external, class: cls, href = "", ...rest } = Astro.props;
const classes = ["tlink", `tlink--${variant}`, cls];
---

{external ? (
  <ExternalLink class:list={classes} href={String(href)} {...rest}>
    <slot />
  </ExternalLink>
) : (
  <a class:list={classes} href={href} {...rest}>
    <slot />
  </a>
)}

<style>
  @layer components {
    .tlink {
      display: inline-flex;
      align-items: center;
      gap: 0.45em;
      font-weight: 500;
      transition:
        border-color var(--duration-quick),
        color var(--duration-quick);
    }

    /* the new-tab arrow (ExternalLink) sits closer than the flex gap would put it */
    .tlink > :global(.ext) {
      margin-inline-start: -0.2em;
    }

    .tlink--outline {
      min-height: 44px;
      padding: 0 1rem;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-s);
      text-decoration: none;
      color: var(--ink);
    }

    @media (hover: hover) {
      .tlink--outline:hover {
        color: var(--ink);
        border-color: var(--accent);
      }
    }

    .tlink--underline {
      min-height: 40px;
      text-decoration-color: var(--line-strong);
      text-underline-offset: 0.22em;
    }

    @media (hover: hover) {
      .tlink--underline:hover {
        color: var(--accent);
        text-decoration-color: currentcolor;
      }
    }
  }
</style>

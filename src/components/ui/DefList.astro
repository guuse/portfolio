---
/** A typeset definition list: term on the left, description on the right from 640px. */
interface Props {
  items: { term: string; detail: string }[];
}
const { items } = Astro.props;
---

<dl class="deflist rows reveal-set">
  {items.map((it, i) => (
    <div data-i={i}>
      <dt>{it.term}</dt>
      <dd>{it.detail}</dd>
    </div>
  ))}
</dl>

<style>
  @layer components {
    .deflist {
      display: grid;
    }

    .deflist > div {
      position: relative;
      display: grid;
      gap: 2px 24px;
      padding-block: 0.8rem;
    }

    /* the hairline between rows; a pseudo-element so it can draw in (src/styles/motion.css) */
    .deflist > div::before {
      content: "";
      position: absolute;
      inset: 0 0 auto;
      height: 1px;
      background: var(--line);
      transform-origin: left;
    }

    .deflist > div:first-child {
      padding-top: 0;
    }

    .deflist > div:first-child::before {
      content: none;
    }

    @media (width >= 640px) {
      .deflist > div {
        grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
      }
    }

    .deflist dt {
      font-weight: 600;
    }

    .deflist dd {
      color: var(--ink-muted);
    }
  }
</style>

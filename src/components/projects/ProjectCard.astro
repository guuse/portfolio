---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Drawing from "~/components/art/Drawing.astro";
import TextLink from "~/components/ui/TextLink.astro";
import { card } from "~/lib/art";
import { caseStudyHref, liveArt } from "~/lib/projects";
import mtg from "~/assets/covers/mtg-wide.webp";

/**
 * A project on the projects page: its cover, why it exists, four facts and the stack. The
 * cover is the same live drawing as on the homepage card (the MTG one the same collage), so
 * it plays here too, faster while the card is hovered or focused.
 */
interface Props {
  project: CollectionEntry<"projects">["data"];
}
const { project: p } = Astro.props;
const live = p.id === "mtg-suite" ? null : liveArt[p.id];
const href = caseStudyHref(p.id);
---

<article class="pcard" aria-labelledby={`pc-${p.id}`} data-card-host>
  {/* the cover repeats the title link, so it's hidden from assistive tech and the tab order */}
  <a class={`pcard__media vt-art--${p.id}`} href={href} tabindex="-1" aria-hidden="true">
    {live ? (
      <span class="pcard__art" data-card={live.motion}>
        <Drawing svg={card(live.card)} />
      </span>
    ) : (
      <Picture
        src={mtg}
        alt=""
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        widths={[700, 1400, 2000]}
        sizes="(width < 960px) 100vw, 680px"
      />
    )}
  </a>
  <div class="pcard__body">
    <p class="pcard__meta">{p.meta}</p>
    <h2 class="pcard__title" id={`pc-${p.id}`}>
      <a href={href}>{p.title}</a>
    </h2>
    <p class="pcard__line">{p.line}</p>
    <p class="pcard__why">{p.why}</p>
    <ul class="pcard__facts">
      {p.facts.map((f) => (
        <li>{f}</li>
      ))}
    </ul>
    <p class="pcard__stack">{p.stack}</p>
    <TextLink variant="underline" href={href}>
      Read the case study<span class="visually-hidden">: {p.title}</span>{" "}
      <span aria-hidden="true">&rarr;</span>
    </TextLink>
  </div>
</article>

<style>
  @layer components {
    .pcard {
      display: grid;
      gap: 1.5rem var(--space-gutter);
      align-items: center;
    }

    /* side by side from tablet width; there the cover lines up with the title, not the middle */
    @media (--cards) {
      .pcard {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: start;
      }
    }

    @media (--lg) {
      .pcard {
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        align-items: center;
      }
    }

    .pcard__media {
      display: block;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: var(--radius-s);
      background: var(--surface-card);
      transition:
        transform var(--duration-base) var(--ease-out),
        border-color var(--duration-base) var(--ease-out);
    }

    /* the cover lifts and takes the accent edge while its card is hovered or focused */
    .pcard:focus-within .pcard__media {
      transform: translate3d(0, -3px, 0);
      border-color: var(--accent);
    }

    @media (hover: hover) {
      .pcard:hover .pcard__media {
        transform: translate3d(0, -3px, 0);
        border-color: var(--accent);
      }

      .pcard:hover .pcard__media :global(img) {
        transform: scale(1.02);
      }
    }

    .pcard__media:active {
      transform: translate3d(0, -1px, 0) scale(0.985);
      transition-duration: var(--duration-quick);
    }

    .pcard__media :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform var(--duration-slow) var(--ease-out);
    }

    .pcard:focus-within .pcard__media :global(img) {
      transform: scale(1.02);
    }

    /*
     * The drawing is a 4:5 card that keeps its bottom fifth for the homepage card's text; here
     * it stands in the middle, a little taller than the cover, so the drawing itself is centred.
     */
    .pcard__art {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
    }

    .pcard__art :global(.scene-svg) {
      flex: none;
      width: auto;
      height: 118%;
    }

    .pcard__body {
      display: grid;
      gap: 0.75rem;
      justify-items: start;
    }

    .pcard__meta {
      color: var(--ink-subtle);
      font-size: var(--text-small);
    }

    .pcard__title {
      width: fit-content;
      font-family: var(--font-heading);
      font-size: var(--text-h2);
      line-height: 1;
    }

    .pcard__title a {
      text-decoration: none;
    }

    .pcard__line {
      font-size: var(--text-lead);
      line-height: 1.4;
    }

    .pcard__why {
      max-width: var(--size-measure);
      color: var(--ink-muted);
    }

    .pcard__facts {
      display: grid;
      gap: 0.35rem;
      padding-left: 1.1em;
      color: var(--ink-muted);
    }

    .pcard__facts li::marker {
      color: var(--ink-subtle);
    }

    @media (prefers-reduced-motion: reduce) {
      .pcard:is(:hover, :focus-within) .pcard__media,
      .pcard__media:active {
        transform: none;
      }

      .pcard:is(:hover, :focus-within) .pcard__media :global(img) {
        transform: none;
      }
    }

    .pcard__stack {
      color: var(--ink-subtle);
      font-size: var(--text-small);
    }
  }
</style>

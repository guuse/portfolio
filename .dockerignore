# What never belongs in a build context. The runtime image only receives
# dist/ and the nginx config either way; this keeps the context small, the
# layer cache stable, and secrets and the design archive out of the builder.

# VCS, editors, OS litter
.git
.gitignore
.gitattributes
.github
.vscode
.idea
.DS_Store
*.swp

# Dependencies and build output (rebuilt inside the image)
node_modules
dist
.astro
.cache
coverage

# Not part of the site
design
docs
infrastructure/homeserver
infrastructure/*.yaml
infrastructure/README.md
tests
test-results
playwright-report
blob-report
lighthouse*
.lighthouseci
**/*.md
!src/**/*.md

# Never in an image
.env
.env.*
!.env.example
*.pem
*.key
npm-debug.log*
Dockerfile
.dockerignore
